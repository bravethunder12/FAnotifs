{
  "manifest_version": 2,
  "name": "FA Notif Saver",
  "description": "Save a record of notifs from Notes page. i=watches, p=favs",
  "version": "1.0",
  "permissions": [
    "downloads",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.furaffinity.net/msg/others/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": {
      "128": "icon128.png"
    },
    "default_title": "FA Notif Saver"
  },
  "icons": {
    "128": "icon128.png"
  }
}
